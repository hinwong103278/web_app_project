{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
    <h1>{{ _('Category') }}</h1>
    {% if show_controls %}
        <div class="row">
            <div class="col-md-4">{{ wtf.quick_form(form) }}</div>
        </div>
    {% endif %}
    <div class="row">
        {% for category in categories %}
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">{{ category.name }}</h5>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}