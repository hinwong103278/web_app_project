{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
<div class="product-filter mb-4">
    <form class="row g-3">
        <div class="col-md-3">
            <input type="text" class="form-control" name="q" placeholder="搜索商品">
        </div>
        <div class="col-md-2">
            <select class="form-select" name="category">
                <option value="">所有分类</option>
                {% for cat in categories %}
                <option value="{{ cat.id }}" {% if cat.id == current_category %}selected{% endif %}>
                    {{ cat.name }}
                </option>
                {% endfor %}
            </select>
        </div>
{% endblock %}