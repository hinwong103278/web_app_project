{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
    <h1>{{ _('Review Product') }}</h1>
    <div class="row">
        <div class="col-md-6">
            {{ wtf.quick_form(form) }}
        </div>
    </div>
    <hr>
    <h2>{{ _('Reviews') }}</h2>
    <div class="row">
        {% if product.reviews %}
            {% for review in product.reviews %}
                <div class="col-md-12">
                    <div class="card mb-3">
                        <div class="card-body">
                            <p class="card-text">{{ review.content }}</p>
                            <p class="card-text">
                                <small class="text-muted">{{ _('By User ID:') }} {{ review.user_id }} | {{ review.timestamp }}</small>
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p>{{ _('No reviews yet.') }}</p>
        {% endif %}
    </div>
{% endblock %}