{% extends "base.html.j2" %}

{% block content %}
  <h2>Search Results for "{{ query }}"</h2>
  
  {% if results %}
    <ul class="search-results">
    {% for result in results %}
      <li>
        <h3>{{ result.title }}</h3>
        <p>{{ result.content|truncate(300) }}</p>
      </li>
    {% endfor %}
    </ul>
  {% else %}
    <p>No results found</p>
  {% endif %}
{% endblock %}