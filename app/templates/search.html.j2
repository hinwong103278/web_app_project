{% extends "base.html.j2" %}

{% block title %}Search Results{% endblock %}

{% block content %}
    <h1>Search Results for "{{ query }}"</h1>
    
    {% if results %}
        <ul>
            {% for item in results %}
                <li>{{ item.name }} ({{ item.category }})</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>No results found.</p>
    {% endif %}
{% endblock %}