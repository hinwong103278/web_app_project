{% extends "base.html.j2" %}

{% block app_content %}
<div class="container my-5">
    <h1 class="mb-4 text-primary">{{ _('Edit Brand') }}: {{ brand.name }}</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="POST" action="{{ url_for('edit_brand', brand_id=brand.id) }}">
                {{ form.hidden_tag() }}
                <div class="form-group">
                    <label for="name">{{ form.name.label }}</label>
                    {{ form.name(class="form-control", id="name") }}
                </div>
                <div class="form-group">
                    <label for="description">{{ form.description.label }}</label>
                    {{ form.description(class="form-control", id="description") }}
                </div>
                <button type="submit" class="btn btn-primary">{{ _('Save Changes') }}</button>
                <a href="{{ url_for('view_brands') }}" class="btn btn-secondary">{{ _('Cancel') }}</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}
