{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
  <h2>Your Orders</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Product</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Created At</th>
      </tr>
    </thead>
    <tbody>
      {% for order in orders %}
      <tr>
        <td><a href="{{ url_for('order_detail', order_id=order.id) }}">#{{ order.id }}</a></td>
        <td>{{ order.product_name }}</td>
        <td>${{ "%.2f"|format(order.amount) }}</td>
        <td>
          <span class="badge bg-{{ 'success' if order.status == OrderStatus.DELIVERED else 'warning' }}">
            {{ order.status.value }}
          </span>
        </td>
        <td>{{ moment(order.created_at).format('LLL') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}