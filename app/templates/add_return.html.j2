{% extends "base.html.j2" %}

{% block content %}
<h1>{{ _('Add Return') }}</h1>

<form method="POST">
    {{ form.hidden_tag() }}
    <div class="form-group">
        <label for="order_id">{{ form.order_id.label }}</label>
        {{ form.order_id(class="form-control", id="order_id") }}
    </div>
    <div class="form-group">
        <label for="reason">{{ form.reason.label }}</label>
        {{ form.reason(class="form-control", id="reason", rows=5) }}
    </div>
    <button type="submit" class="btn btn-success">{{ _('Submit') }}</button>
    <a href="{{ url_for('view_returns') }}" class="btn btn-secondary">{{ _('Cancel') }}</a>
</form>
{% endblock %}