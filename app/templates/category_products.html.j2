{% extends "base.html.j2" %}

{% block app_content %}
<div class="container my-5">
    <h1 class="mb-4 text-primary">{{ _('Products in Category:') }} {{ category.name }}</h1>
    <p class="text-muted">{{ category.description }}</p>
    
    {% if products %}
        <div class="row">
            {% for product in products %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title text-primary">{{ product.name }}</h5>
                            <p class="card-text">{{ product.description }}</p>
                            <p class="card-text"><strong>{{ _('Price:') }} ${{ product.price }}</strong></p>
                            <a href="#" class="btn btn-primary btn-block">{{ _('View Product') }}</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            {{ _('No products available in this category. Please check back later.') }}
        </div>
    {% endif %}
</div>
{% endblock %}
