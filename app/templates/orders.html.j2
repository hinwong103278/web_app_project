{% extends "base.html.j2" %}
{% block app_content %}
    <h1>{{ _('Your Orders') }}</h1>
    {% if orders %}
        <table class="table">
            <thead>
                <tr>
                    <th>{{ _('Order ID') }}</th>
                    <th>{{ _('Date') }}</th>
                    <th>{{ _('Total Price') }}</th>
                    <th>{{ _('Status') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td>#{{ order.id }}</td>
                        <td>{{ order.date.strftime('%Y-%m-%d %H:%M') }}</td>
                        <td>${{ order.cost }}</td>
                        <td>{{ order.status }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>{{ _('You have no orders yet.') }}</p>
    {% endif %}
{% endblock %}
