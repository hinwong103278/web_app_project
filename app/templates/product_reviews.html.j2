{% extends "base.html.j2" %}
{% block content %}
    <h1>{{ _('Product Reviews') }}</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ _('Product Name') }}</th>
                <th>{{ _('Review Content') }}</th>
                <th>{{ _('Rating') }}</th>
                <th>{{ _('Timestamp') }}</th>
                <th>{{ _('Actions') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for review in product_reviews %}
                <tr>
                    <td>{{ review.product.name }}</td>
                    <td>{{ review.content }}</td>
                    <td>{{ review.rating }}</td>
                    <td>{{ review.timestamp.strftime('%Y-%m-%d %H:%M:%S') }}</td>
                    <td>
                        <a href="{{ url_for('edit_product_review', review_id=review.id) }}"
                           class="btn btn-primary btn-sm">{{ _('Edit') }}</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <a href="{{ url_for('add_product_review') }}" class="btn btn-success">{{ _('Add Review') }}</a>
{% endblock %}
