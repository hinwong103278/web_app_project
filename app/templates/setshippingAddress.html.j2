{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
    <h1>{{ _('shippingAddress') }}</h1>
    <div class="row">
        <div class="col-md-4">{{ wtf.quick_form(form) }}</div>
    </div>
    {% if address %}
        <ul>
            {% for s in address %}
            <li>
                <p>{{ s.address }}</p>
                <a href="{{ url_for('remove_address', address_id=s.id) }}"><button type="submit">Remove address</button></a>
            </li>
            {% endfor %}  
    {% endif %}  
{% endblock %}