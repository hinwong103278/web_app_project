{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
{% if current_user.username == "Admin"%}
    <h1>{{ _('Payment') }}</h1>
    <div class="row">
        <div class="col-md-4">{{ wtf.quick_form(form) }}</div>
    </div>
    {% if payment %}
        <ul>
            {% for p in payment %}
                <li>
                <img src="{{ p.logo }}" alt="Payment Image" width="150">
                <a href="{{ url_for('remove_payment', payment_id=p.id) }}"><button type="submit">Remove Payment</button></a>
            </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endif %}
{% endblock %}