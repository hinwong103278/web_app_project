{% extends "base.html.j2" %}

{% block app_content %}
<div class="container my-5">
    <h1 class="mb-4 text-primary">{{ _('Order Status') }}</h1>

    {% if order_statuses %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>{{ _('Product') }}</th>
                        <th>{{ _('Order ID') }}</th>
                        <th>{{ _('Timestamp') }}</th>
                        <th>{{ _('Status') }}</th>
                        {% if current_user.username == "Admin" %}
                        <th>{{ _('Actions') }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for status in order_statuses %}
                    <tr>
                        <td>{{ status.product.name }}</td>
                        <td>{{ status.order_id }}</td>
                        <td>{{ status.timestamp }}</td>
                        <td>
                            <span class="badge 
                                {% if status.status == 'Pending' %}badge-warning
                                {% elif status.status == 'Completed' %}badge-success
                                {% elif status.status == 'Cancelled' %}badge-danger
                                {% else %}badge-secondary{% endif %}">
                                {{ status.status }}
                            </span>
                        </td>
                        {% if current_user.username == "Admin" %}
                        <td>
                            <a href="{{ url_for('edit_order_status', status_id=status.id) }}" class="btn btn-sm btn-info">
                                {{ _('Edit') }}
                            </a>
                            <form action="{{ url_for('delete_order_status', status_id=status.id) }}" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('{{ _('Are you sure you want to delete this order?') }}')">
                                    {{ _('Delete') }}
                                </button>
                            </form>
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            {{ _('No order statuses available.') }}
        </div>
    {% endif %}
</div>
{% endblock %}
