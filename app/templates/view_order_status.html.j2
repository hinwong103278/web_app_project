<table>
    <thead>
        <tr>
            <th>{{ _('Product') }}</th>
            <th>{{ _('Order ID') }}</th>
            <th>{{ _('Timestamp') }}</th>
            <th>{{ _('Actions') }}</th>
        </tr>
    </thead>
    <tbody>
        {% for status in order_statuses %}
        <tr>
            <td>{{ status.product.name }}</td>
            <td>{{ status.order_id }}</td>
            <td>{{ status.timestamp }}</td>
            <td>
                <a href="{{ url_for('edit_order_status', status_id=status.id) }}">{{ _('Edit') }}</a>
                <form action="{{ url_for('delete_order_status', status_id=status.id) }}" method="POST" style="display:inline;">
                    <button type="submit">{{ _('Delete') }}</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
