{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block app_content %}
    <h1>{{ _('Brand') }}</h1>
    {% if show_controls %}
        <div class="row">
            <div class="col-md-4">{{ wtf.quick_form(form) }}</div>
        </div>
    {% endif %}
    <div class="row">
        {% for brand in brands %}
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <img src="{{ brand.logo }}" class="card-img-top" alt="{{ brand.name }}" style="width: 100%; height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">{{ brand.name }}</h5>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}