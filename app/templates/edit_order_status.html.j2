{% extends "base.html.j2" %}

{% block content %}
<h1>{{ _('Edit Order Status') }}</h1>

<form method="POST">
    {{ form.hidden_tag() }}
    <div class="form-group">
        <label for="status">{{ form.status.label }}</label>
        {{ form.status(class="form-control", id="status") }}
        {% if form.status.errors %}
            <div class="text-danger">{{ form.status.errors[0] }}</div>
        {% endif %}
    </div>
    <div class="form-group">
        <label for="product_id">{{ form.product_id.label }}</label>
        {{ form.product_id(class="form-control", id="product_id") }}
        {% if form.product_id.errors %}
            <div class="text-danger">{{ form.product_id.errors[0] }}</div>
        {% endif %}
    </div>
    <div class="form-group">
        <label for="order_id">{{ form.order_id.label }}</label>
        {{ form.order_id(class="form-control", id="order_id") }}
        {% if form.order_id.errors %}
            <div class="text-danger">{{ form.order_id.errors[0] }}</div>
        {% endif %}
    </div>
    <button type="submit" class="btn btn-primary">{{ _('Update Status') }}</button>
    <a href="{{ url_for('view_order_status') }}" class="btn btn-secondary">{{ _('Cancel') }}</a>
</form>
{% endblock %}