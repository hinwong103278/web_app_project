{% block scripts %}
    {{ super() }}
    <script>
        // Slideshow functionality
        let slideIndex = 1;
        showSlides(slideIndex);

        // Next/previous controls
        function plusSlides(n) {
            showSlides(slideIndex += n);
        }

        // Thumbnail image controls
        function currentSlide(n) {
            showSlides(slideIndex = n);
        }

        function showSlides(n) {
            let i;
            let slides = document.getElementsByClassName("mySlides");
            let dots = document.getElementsByClassName("dot");
            
            if (n > slides.length) {slideIndex = 1}
            if (n < 1) {slideIndex = slides.length}
            
            for (i = 0; i < slides.length; i++) {
                slides[i].style.display = "none";
            }
            
            for (i = 0; i < dots.length; i++) {
                dots[i].className = dots[i].className.replace(" active", "");
            }
            
            slides[slideIndex-1].style.display = "block";
            dots[slideIndex-1].className += " active";
        }

        // Auto-advance slides every 5 seconds
        setInterval(() => {
            plusSlides(1);
        }, 5000);

        // Add to cart functionality
        document.addEventListener('DOMContentLoaded', function() {
            const addToCartButtons = document.querySelectorAll('.btn-primary');
            
            addToCartButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productCard = this.closest('.card');
                    const productName = productCard.querySelector('.card-title').textContent;
                    const productPrice = productCard.querySelector('.price').textContent;
                    
                    // You can replace this with actual cart logic
                    alert(`已將 ${productName} 加入購物車\n價格: ${productPrice}`);
                    
                    // Here you would typically:
                    // 1. Send an AJAX request to your backend
                    // 2. Update the cart counter in the navbar
                    // 3. Maybe show a toast notification
                });
            });
        });

        // Category button hover effects
        const categoryButtons = document.querySelectorAll('.category-btn');
        categoryButtons.forEach(button => {
            button.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.05)';
            });
            button.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
            });
        });

        // Responsive adjustments
        function handleResponsive() {
            const slideshow = document.querySelector('.slideshow-container');
            if (window.innerWidth <= 768) {
                slideshow.style.height = '200px';
            } else {
                slideshow.style.height = 'auto';
            }
        }

        window.addEventListener('resize', handleResponsive);
        handleResponsive();
    </script>
{% endblock %}
