{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block head %}
    {{ super() }}
    <style>
        /* 表單樣式 */
        form {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 5px;
            box-shadow: 0px 4px 8px rgba(255, 255, 255, 0.1);
        }

        form input, form textarea, form select, form button {
            width: 100%;
            margin-bottom: 15px;
            padding: 10px;
            border: 1px solid #104274;
            border-radius: 5px;
            font-size: 1rem;
        }

        form button {
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        form button:hover {
            background-color: #0056b3;
        }

        /* 帖子樣式 */
        .post {
            margin: 20px auto;
            padding: 15px;
            background: white;
            border-left: 5px solid #007bff;
            border-radius: 5px;
            box-shadow: 0px 4px 8px rgba(255, 255, 255, 0.1);
        }
    </style>
{% endblock %}

{% block app_content %}
    <h1>Hi, {{ current_user.username }}!</h1>

    {% if form %}
        <form method="post">
            {{ form.hidden_tag() }}
            {{ form.post.label }}<br>
            {{ form.post(size=30) }}
            <button type="submit">{{ _('Submit') }}</button>
        </form>
    {% endif %}

    {% for post in posts %}
        <div class="post">
            <h2>{{ post.body }}</h2>
            <p>Posted by {{ post.author.username }}</p>
        </div>
    {% endfor %}
{% endblock %}
