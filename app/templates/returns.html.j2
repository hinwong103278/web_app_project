{% extends "base.html.j2" %}
{% block content %}
    <h1>{{ _('Returns') }}</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ _('ID') }}</th>
                <th>{{ _('Order ID') }}</th>
                <th>{{ _('Reason') }}</th>
                <th>{{ _('Status') }}</th>
                <th>{{ _('Actions') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for return_item in returns %}
                <tr>
                    <td>{{ return_item.id }}</td>
                    <td>{{ return_item.order_id }}</td>
                    <td>{{ return_item.reason }}</td>
                    <td>{{ return_item.status }}</td>
                    <td>
                        <a href="{{ url_for('edit_return', return_id=return_item.id) }}"
                           class="btn btn-warning btn-sm">{{ _('Edit') }}</a>
                        <form action="{{ url_for('delete_return', return_id=return_item.id) }}"
                              method="POST"
                              style="display:inline">
                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('{{ _('Are you sure you want to delete this return?') }}');">
                                {{ _('Delete') }}
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <a href="{{ url_for('add_return') }}" class="btn btn-success">{{ _('Add New Return') }}</a>
{% endblock %}
